# Matinee relay configuration.
#
# Copy this file to .env, fill in what you need, then run `npm start`.
# `.env` is gitignored. The real environment still wins, so one-off overrides
# work too: env PORT=3000 MATINEE_MEMBER=yourname npm start

# HTTP port for the relay and the browser mock.
PORT=3000

# Public Letterboxd handle used when the phone has not connected one.
MATINEE_MEMBER=kerthfyadao

# Optional. Search stays disabled with a clear note until this is set.
# Get a key at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Optional and experimental. A letterboxd.com `letterboxd.signed.in` cookie.
# Setting this enables POST /api/log. Keep it on the relay; never ship it in
# the app or commit it. Capture it with `pbpaste | npm run cookie`; see
# docs/GUIDE.md before using it.
# LB_SESSION_COOKIE=

# Deterministic local mode: serve the bundled feed/film snapshots instead of
# calling Letterboxd. Useful for screenshots and offline development.
# MATINEE_OFFLINE=1

# Test-only upstream overrides. The integration suites point these at local
# self-signed HTTPS mocks; do not set them in normal use.
# MATINEE_TMDB_ORIGIN=https://127.0.0.1:PORT
# MATINEE_LB_ORIGIN=https://127.0.0.1:PORT
# MATINEE_INSECURE_TLS=1
